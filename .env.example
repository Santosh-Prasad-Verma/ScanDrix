# Scandrix Backend Environment Configuration Template
# Commit this file; never commit .env itself (Master Rule 1.5)

# Runtime Environment (development, staging, production)
APP_ENV=development
PORT=8080
WEBHOOKS_PORT=8081

# PostgreSQL 16 Connection (Supabase / Self-Hosted)
DATABASE_URL=postgres://postgres:password@localhost:5432/scandrix?sslmode=disable

# RabbitMQ 3.13+ (Quorum Queues)
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# Redis / Valkey
REDIS_URL=redis://localhost:6379

# Appwrite Platform (Storage / Realtime / Notifications)
APPWRITE_ENDPOINT=https://sgp.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=

# SCM Webhook HMAC Secrets
GITHUB_WEBHOOK_SECRET=
GITLAB_WEBHOOK_SECRET=

# AI Provider Credentials (BYOK)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
VLLM_ENDPOINT=
