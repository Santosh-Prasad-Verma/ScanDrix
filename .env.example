# ==========================================
# CodeHound Local Development Environment Example
# ==========================================

# LocalStack Pro Configuration
LOCALSTACK_AUTH_TOKEN=your_localstack_auth_token_here
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_ENDPOINT_URL=http://localhost:4566
SERVICES=s3,secretsmanager,kms,iam,cloudwatch,wafv2

# PostgreSQL 18 Local Database (Aurora / RDS Equivalent)
POSTGRES_DB=codehound_dev
POSTGRES_USER=codehound
POSTGRES_PASSWORD=devpassword
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
DATABASE_URL=postgresql://codehound:devpassword@localhost:5433/codehound_dev?sslmode=disable

# DataStax Astra DB Vector (Cloud / Staging)
ASTRA_DB_APPLICATION_TOKEN=your_astra_token_here
ASTRA_DB_API_ENDPOINT=https://your-astra-db-id-region.apps.astra.datastax.com
ASTRA_DB_KEYSPACE=default_keyspace

# Redis Local Cache (ElastiCache Equivalent)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Temporal Durable Workflow Engine
TEMPORAL_HOST_PORT=localhost:7233
TEMPORAL_UI_PORT=8080

# NATS JetStream Event Bus
NATS_URL=nats://localhost:4222

# AI Multi-Model Routing Gateway (OpenRouter)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Doppler Secrets Management (Replaces AWS Secrets Manager / Vault)
DOPPLER_TOKEN=dp.st.dev.your_service_token_here
DOPPLER_PROJECT=codehound
DOPPLER_CONFIG=dev

# Supabase Auth & PostgreSQL Cloud
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
SUPABASE_SECRET_KEY=sb_secret_your_secret_key_here
SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_DATABASE_URL=postgresql://postgres.your-project-ref:your_db_password@aws-0-region.pooler.supabase.com:5432/postgres?sslmode=require
SUPABASE_POOLER_URL=postgresql://postgres.your-project-ref:your_db_password@aws-0-region.pooler.supabase.com:6543/postgres?sslmode=require

