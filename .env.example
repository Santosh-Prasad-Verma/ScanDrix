# Scandrix Backend Environment Configuration Template
# Commit this file; never commit .env itself (Master Rule 1.5)

# Runtime Environment (development, staging, production)
APP_ENV=development
PORT=8080
WEBHOOKS_PORT=8081

# Database Connection (Supabase Managed PostgreSQL 16 + pgvector)
# Get from Supabase Project Settings -> Database -> Connection string (URI)
DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require

# Docker Compose database roles.
# POSTGRES_* is the privileged owner/migration role. It is used ONLY by the
# one-shot scandrix-migrate job, never by a long-running service container.
# SCANDRIX_RUNTIME_* is the least-privilege role the API and webhooks connect as:
# NOSUPERUSER NOBYPASSRLS, so RLS policies are actually enforced instead of
# silently bypassed. Create it with migrations/ops/002_least_privilege_runtime_role.sql
# (or an equivalent managed-DB grant script) before first use.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=scandrix
SCANDRIX_RUNTIME_USER=scandrix_runtime
SCANDRIX_RUNTIME_PASSWORD=
# Escape hatch for managed Postgres where the host/user differ from the default.
# Leave empty to let Compose build the runtime DSN from the variables above.
DATABASE_RUNTIME_URL=

# RabbitMQ 3.13+ (Quorum Queues)
#
# Leave this UNSET for Compose deployments. Compose builds the URL from
# RABBITMQ_USER and RABBITMQ_PASSWORD via a ${VAR:-default} expansion, and that
# expansion is skipped entirely whenever RABBITMQ_URL is present -- so a value
# copied from this file silently replaces the real credentials with
# guest:guest, which RabbitMQ refuses for any non-loopback connection. That
# broke every service that depends on the broker (AUDIT_REMEDIATION.md F-53).
#
# Set it only when running the broker outside Compose, and never with the
# guest account.
# RABBITMQ_URL=

# Redis / Valkey
# Redis requires a password (AUDIT_REMEDIATION.md F-54): it backs the rate
# limiters and the account-lockout counter. Generate with:
#   openssl rand -base64 32 | tr -d '\n/+=' | cut -c1-40
REDIS_PASSWORD=
REDIS_URL=redis://:${REDIS_PASSWORD}@localhost:6379

# Appwrite Platform (Storage / Realtime / Notifications)
APPWRITE_ENDPOINT=https://sgp.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=

# Doppler Secrets Management
DOPPLER_TOKEN=
DOPPLER_PROJECT=scandrix
DOPPLER_CONFIG=dev

# Web Application URL (for CLI and OAuth redirects)
APP_BASE_URL=http://localhost:3000

# Authentication & Security Secrets (Master Rule 1.1)
# Generate with: openssl rand -hex 32
JWT_SECRET=
KMS_MASTER_KEY=
# Symmetric key for encrypting integration access tokens (GitHub PATs, etc.)
# Falls back to KMS_MASTER_KEY if not set. Generate with: openssl rand -hex 32
INTEGRATION_ENCRYPTION_KEY=

# OAuth 2.0 Social Login Credentials
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITLAB_OAUTH_CLIENT_ID=
GITLAB_OAUTH_CLIENT_SECRET=

# Transactional Email / SMTP Credentials (Master Rule 1.1)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@scandrix.dev

# SCM Platform Integrations & Webhook HMAC Secrets
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=
GITLAB_WEBHOOK_SECRET=
BITBUCKET_USERNAME=
BITBUCKET_PASSWORD=
BITBUCKET_WEBHOOK_SECRET=
AZURE_DEVOPS_PAT=
AZURE_DEVOPS_WEBHOOK_SECRET=
FORGEJO_TOKEN=
FORGEJO_WEBHOOK_SECRET=
FORGEJO_BASE_URL=https://codeberg.org

# AI Provider Credentials (BYOK & Enterprise Multi-Cloud)
OPENROUTER_API_KEY=                           # OpenRouter API Key
AI_MODEL_DEFAULT=free/deepseek-v4-pro-0813    # Primary model (DeepSeek Pro reasoning & coding)
AI_MODEL_FALLBACK=free/gemini-3.7-flash       # Fallback model (Fast multi-turn & agentic workflows)
AI_MODEL_TRIAGE=free/gemini-3.7-flash         # Fast preliminary diff parsing and filtering
AI_MODEL_LOGIC=free/deepseek-v4-pro-0813      # Algorithmic logic analysis
AI_MODEL_SECURITY=free/deepseek-v4-pro-0813   # Deep vulnerability & AST security audit
AI_MODEL_THREAT_MODEL=free/deepseek-v4-pro-0813 # Threat modeling & attack surface mapping
AI_MODEL_ARBITER=free/deepseek-v4-pro-0813    # Multi-agent peer consensus arbiter
AI_MODEL_SYNTHESIZER=free/deepseek-v4-pro-0813 # Final review finding & remediation synthesis
OPENAI_API_KEY=                               # OpenAI / APInex API key (sk-apx...)
OPENAI_BASE_URL=https://api.apinex.bond/v1    # OpenAI-compatible base URL (e.g. https://api.apinex.bond/v1)
DEEPSEEK_API_KEY=                             # DeepSeek API (deepseek-chat / reasoner)
ANTHROPIC_API_KEY=                            # Anthropic (Claude 3.7 / 3.5 Sonnet)
GEMINI_API_KEY=                               # Google AI Studio (Gemini 2.5 Pro)
BEDROCK_BEARER_TOKEN=                         # AWS Bedrock Converse API token
BEDROCK_REGION=us-east-1                      # AWS Bedrock region
VERTEX_ACCESS_TOKEN=                          # Google Cloud Vertex AI access token
VERTEX_PROJECT_ID=                            # Google Cloud Project ID
VERTEX_LOCATION=us-central1                   # Google Cloud Region
MOONSHOT_API_KEY=                         # Moonshot AI / Kimi direct API key
ALIBABA_API_KEY=                          # Alibaba Model Studio / Qwen direct API key
MINIMAX_API_KEY=                          # MiniMax direct API key
XAI_API_KEY=                              # xAI Grok direct API key
MISTRAL_API_KEY=                          # Mistral AI direct API key
GROQ_API_KEY=                             # Groq Cloud direct API key (gsk_...)
COHERE_API_KEY=                           # Cohere direct API key

# Ephemeral Remote Sandbox (E2B MicroVM) & Proof-of-Fix Execution
E2B_API_KEY=
E2B_ENDPOINT=
PROOFOFFIX_SANDBOX_ENABLED=false

# Razorpay Subscriptions & Billing Integration
RAZORPAY_KEY_ID=                                # Razorpay API Key ID (e.g. rzp_test_xxx or rzp_live_xxx)
RAZORPAY_KEY_SECRET=                            # Razorpay API Key Secret
RAZORPAY_WEBHOOK_SECRET=                        # Razorpay Webhook Signing Secret (from Razorpay Dashboard)

# Scandrix CLI Client Configuration
SCANDRIX_SERVER_URL=http://localhost:8080
SCANDRIX_API_KEY=

# Enterprise License (optional - omit both to run unlicensed on the Community plan)
# Base64 Ed25519 vendor public key used to verify license tokens. PEM armour is accepted.
SCANDRIX_LICENSE_PUBLIC_KEY=
# Signed license token issued by the vendor. Mutually exclusive with SCANDRIX_LICENSE_FILE.
SCANDRIX_LICENSE_KEY=
# Path to a signed license token on disk, for deployments that mount secrets as files.
SCANDRIX_LICENSE_FILE=
# Rotation ring: comma-separated "keyID:base64PublicKey" pairs that stay valid during a
# signing-key rotation. Only needed while a rotation overlap is in progress.
SCANDRIX_LICENSE_KEY_RING=
# Expected hardware/cluster fingerprint. When set, a license whose
# hardware_fingerprint claim differs is rejected at boot. Leave empty to disable binding.
SCANDRIX_HARDWARE_FINGERPRINT=

# License authority tooling (scandrix-keygen). The private key is a secret: keep it in an
# HSM or secret manager and inject it at runtime. Never commit a real value here.
# Preferred for automation: a 0600 file path read via -keyfile.
AUTHORITY_PRIVATE_KEY=

# Sovereign Air-Gapped Operation & Egress Firewall (Master Rule 1.1)
# Set to true to enforce deny-by-default egress firewall blocking all external internet connections.
AIR_GAPPED=false
# Comma-separated list of allowed internal hosts or CIDRs for local model servers (vLLM, Ollama, TGI).
AIRGAP_ALLOWED_HOSTS=localhost,127.0.0.1,::1

# ═══════════════════════════════════════════════════════════════════════════
# SECURITY & AUTHENTICATION (AUDIT_REMEDIATION.md)
# Every value below is read by the application. Names only — never commit a
# real value. Anything marked REQUIRED is enforced at startup in production
# and staging; the process refuses to boot without it.
# ═══════════════════════════════════════════════════════════════════════════

# Token signing. JWT_SECRET is REQUIRED in production; JWT_REFRESH_SECRET is
# REQUIRED and must be a distinct value — it is never derived from
# JWT_SECRET, because deriving it means leaking one yields both.
JWT_REFRESH_SECRET=
JWT_ISSUER=scandrix
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=720h

# Public self-registration on the CLI authorize endpoint. Defaults CLOSED: set
# to "true" only for deployments that intend to allow unauthenticated signups.
ALLOW_PUBLIC_CLI_REGISTRATION=false
# When "true", only invited users may join an organization.
AUTH_STRICT_INVITES_ONLY=false
# When "true", registration returns no session until the address is verified.
# Leave empty for the default (off).
REQUIRE_EMAIL_VERIFICATION=

# Cookie hardening.
#
# The Secure attribute is applied by DEFAULT and must be explicitly disabled for
# plain-HTTP local development. A client-supplied X-Forwarded-Proto header is
# never consulted, and COOKIE_SECURE=false is ignored when the process is
# running as production so a misconfigured prod task cannot downgrade itself.
# See AUDIT_REMEDIATION.md F-19.
#
# COOKIE_SECURE=false   # local HTTP dev only
COOKIE_SECURE=

# CORS. Comma-separated explicit origin allow-list. Never "*" together with
# credentialed requests (Master Rule 4.2).
CORS_ALLOWED_ORIGINS=

# Reverse-proxy trust. TRUSTED_PROXIES is a comma-separated CIDR list; X-Forwarded-For
# and X-Forwarded-Proto are honoured ONLY from an address in this list.
TRUST_PROXY=false
TRUSTED_PROXIES=

# Password hashing work factors. The defaults are the current OWASP/RFC 9106
# baseline. Overriding these can silently weaken hashing, so they are only read
# when you have a reason to.
# PASSWORD_HASH_ALGO: argon2id (default) or bcrypt
PASSWORD_HASH_ALGO=argon2id
ARGON2_MEMORY=65536
ARGON2_ITERATIONS=3
BCRYPT_COST=12

# Bot protection. When TURNSTILE_SECRET_KEY is set, a turnstile_token is
# REQUIRED on the protected requests; leaving the token blank is no longer
# treated as a pass.
TURNSTILE_SECRET_KEY=

# ── Secrets consumed by the application but previously undocumented ────────
# All REQUIRED in production unless noted. Inject from a secret manager.
# Encryption at rest for provider credentials and KMS envelope keys.
SCANDRIX_ENCRYPTION_KEY=
# Webhook signing secrets for the outbound code-management integration.
CODE_MANAGEMENT_SECRET=
CODE_MANAGEMENT_WEBHOOK_TOKEN=
# SCIM provisioning. A per-workspace token is authoritative; the global token
# is consulted only when tenant ambiguity can be ruled out.
SCIM_BEARER_TOKEN=
# Signing keys for review-attestation provenance and for CI result signatures.
PROVENANCE_SIGNING_KEY=
SCANDRIX_CI_SIGNING_KEY=
# MCP manager shared secret and docs portal password.
MCP_MANAGER_SECRET=
MCP_DOCS_PASSWORD=
# Error tracking, transactional email, and LLM observability.
SENTRY_DSN=
RESEND_API_KEY=
LANGFUSE_SECRET_KEY=

# Untrusted-code execution. When false (the default), a failed remote sandbox
# call must fail the command rather than reporting a clean pass. Only set to
# "true" for local development with no untrusted input.
ALLOW_UNSANDBOXED_COMMAND_EXECUTION=false

# ── MCP server (Model Context Protocol) ───────────────────────────────────
# DISABLED by default. Set to "true" to expose the MCP transport at /mcp.
# Even when enabled it requires a valid session token, so this must not be
# enabled on a deployment that has not reviewed which MCP tools are exposed.
SCANDRIX_MCP_SERVER_ENABLED=false

# Deployment topology. Set to "true" only for the hosted multi-tenant service.
# When true, SSO domain verification additionally requires the contact email to
# belong to the domain being verified. Domain ownership itself (a DNS TXT
# challenge) is ALWAYS required in both modes -- there is no self-hosted
# auto-approval path. See AUDIT_REMEDIATION.md F-11.
SCANDRIX_CLOUD_MODE=false

# CLI self-registration. CLOSED by default.
# The CLI approve endpoint can create an owner account and its own workspace.
# It is unauthenticated and exempt from the registration rate limiter, so it is
# only safe when explicitly enabled. See AUDIT_REMEDIATION.md F-13.
# Set to "true" ONLY for a self-hosted instance you want to accept public signups on.
ALLOW_PUBLIC_CLI_REGISTRATION=false
# Second, independent kill switch. Set to "true" to force invite-only regardless
# of the value above.
AUTH_STRICT_INVITES_ONLY=false
