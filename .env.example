# Scandrix Backend Environment Configuration Template
# Commit this file; never commit .env itself (Master Rule 1.5)

# Runtime Environment (development, staging, production)
APP_ENV=development
PORT=8080
WEBHOOKS_PORT=8081

# Database Connection (Supabase Managed PostgreSQL 16 + pgvector)
# Get from Supabase Project Settings -> Database -> Connection string (URI)
DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require

# RabbitMQ 3.13+ (Quorum Queues)
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# Redis / Valkey
REDIS_URL=redis://localhost:6379

# Appwrite Platform (Storage / Realtime / Notifications)
APPWRITE_ENDPOINT=https://sgp.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=

# Web Application URL (for CLI and OAuth redirects)
APP_BASE_URL=http://localhost:3000

# Authentication & Security Secrets (Master Rule 1.1)
# Generate with: openssl rand -hex 32
JWT_SECRET=
KMS_MASTER_KEY=
# Symmetric key for encrypting integration access tokens (GitHub PATs, etc.)
# Falls back to KMS_MASTER_KEY if not set. Generate with: openssl rand -hex 32
INTEGRATION_ENCRYPTION_KEY=

# OAuth 2.0 Social Login Credentials
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITLAB_OAUTH_CLIENT_ID=
GITLAB_OAUTH_CLIENT_SECRET=

# Transactional Email / SMTP Credentials (Master Rule 1.1)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@scandrix.dev

# SCM Platform Integrations & Webhook HMAC Secrets
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=
GITLAB_WEBHOOK_SECRET=
BITBUCKET_USERNAME=
BITBUCKET_PASSWORD=
BITBUCKET_WEBHOOK_SECRET=
AZURE_DEVOPS_PAT=
AZURE_DEVOPS_WEBHOOK_SECRET=
FORGEJO_TOKEN=
FORGEJO_WEBHOOK_SECRET=
FORGEJO_BASE_URL=https://codeberg.org

# AI Provider Credentials (BYOK & Enterprise Multi-Cloud)
OPENROUTER_API_KEY=                           # OpenRouter API Key
AI_MODEL_DEFAULT=free/deepseek-v4-pro-0813    # Primary model (DeepSeek Pro reasoning & coding)
AI_MODEL_FALLBACK=free/gemini-3.7-flash       # Fallback model (Fast multi-turn & agentic workflows)
AI_MODEL_TRIAGE=free/gemini-3.7-flash         # Fast preliminary diff parsing and filtering
AI_MODEL_LOGIC=free/deepseek-v4-pro-0813      # Algorithmic logic analysis
AI_MODEL_SECURITY=free/deepseek-v4-pro-0813   # Deep vulnerability & AST security audit
AI_MODEL_THREAT_MODEL=free/deepseek-v4-pro-0813 # Threat modeling & attack surface mapping
AI_MODEL_ARBITER=free/deepseek-v4-pro-0813    # Multi-agent peer consensus arbiter
AI_MODEL_SYNTHESIZER=free/deepseek-v4-pro-0813 # Final review finding & remediation synthesis
OPENAI_API_KEY=                               # OpenAI / APInex API key (sk-apx...)
OPENAI_BASE_URL=https://api.apinex.bond/v1    # OpenAI-compatible base URL (e.g. https://api.apinex.bond/v1)
DEEPSEEK_API_KEY=                             # DeepSeek API (deepseek-chat / reasoner)
ANTHROPIC_API_KEY=                            # Anthropic (Claude 3.7 / 3.5 Sonnet)
GEMINI_API_KEY=                               # Google AI Studio (Gemini 2.5 Pro)
BEDROCK_BEARER_TOKEN=                         # AWS Bedrock Converse API token
BEDROCK_REGION=us-east-1                      # AWS Bedrock region
VERTEX_ACCESS_TOKEN=                          # Google Cloud Vertex AI access token
VERTEX_PROJECT_ID=                            # Google Cloud Project ID
VERTEX_LOCATION=us-central1                   # Google Cloud Region
MOONSHOT_API_KEY=                         # Moonshot AI / Kimi direct API key
ALIBABA_API_KEY=                          # Alibaba Model Studio / Qwen direct API key
MINIMAX_API_KEY=                          # MiniMax direct API key
XAI_API_KEY=                              # xAI Grok direct API key
MISTRAL_API_KEY=                          # Mistral AI direct API key

# Ephemeral Remote Sandbox (E2B MicroVM) & Proof-of-Fix Execution
E2B_API_KEY=
E2B_ENDPOINT=
PROOFOFFIX_SANDBOX_ENABLED=false

# Razorpay Subscriptions & Billing Integration
RAZORPAY_KEY_ID=                                # Razorpay API Key ID (e.g. rzp_test_xxx or rzp_live_xxx)
RAZORPAY_KEY_SECRET=                            # Razorpay API Key Secret
RAZORPAY_WEBHOOK_SECRET=                        # Razorpay Webhook Signing Secret (from Razorpay Dashboard)

# Scandrix CLI Client Configuration
SCANDRIX_SERVER_URL=http://localhost:8080
SCANDRIX_API_KEY=
