# • Provider : Zoho Billing (Free for first 5 customers, then $15/mo)
# • Role     : End-to-end SaaS recurring billing, customer portal & GST invoices
# • Features : Automatic dunning (payment retries), proration, and webhooks
# • Portal   : https://billing.zoho.in/portal/scandrix
# ─────────────────────────────────────────────────────────────
ZOHO_BILLING_PORTAL_URL=
ZOHO_BILLING_WEBHOOK_SECRET=

# ─────────────────────────────────────────────────────────────
# [E] LEAD CAPTURE & PIPELINE: ZOHO CRM
# ─────────────────────────────────────────────────────────────
# • Provider : Zoho CRM (Forever Free 3-User Plan)
# • Role     : Automatically captures leads from Zoho Bookings demo calls
# • Features : Tracks repository onboarding status, trial conversions, and contacts
# • Portal   : https://crm.zoho.in
# ─────────────────────────────────────────────────────────────
ZOHO_CRM_LEAD_SOURCE=
ZOHO_ACCOUNTS_URL=
ZOHO_CRM_API_DOMAIN=
ZOHO_CRM_CLIENT_ID=
ZOHO_CRM_CLIENT_SECRET=
ZOHO_CRM_REFRESH_TOKEN=

# ─────────────────────────────────────────────────────────────
# [F] PRODUCT ANALYTICS & CONVERSION FUNNELS: POSTHOG
# ─────────────────────────────────────────────────────────────
# • Provider : PostHog Cloud (Forever Free Tier)
# • Quota    : 1,000,000 events/month + 5,000 session recordings/month free
# • Role     : User signup funnels, PR review triggered milestones & replays
# • Portal   : https://us.posthog.com -> Project Settings -> API Keys
# • Status   : Optional (leave blank to disable with zero overhead)
# ─────────────────────────────────────────────────────────────
POSTHOG_API_KEY=
POSTHOG_HOST=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# ─────────────────────────────────────────────────────────────
# [G] LOCAL WORKFLOW AUTOMATION & EVENT BUS: N8N
# ─────────────────────────────────────────────────────────────
# • Provider : n8n (Self-Hosted Open Source Automation Engine)
# • Run Local: docker run -d --name scandrix-n8n -p 5678:5678 -v ~/.n8n:/home/node/.n8n n8nio/n8n
# • Role     : Triggers custom external workflows (Slack/Discord/Email/CRM) on key lifecycle events
# • Events   : user.signed_up • onboarding.completed • first_review.completed
# • Status   : Wired natively in internal/telemetry/product/n8n.go
# ─────────────────────────────────────────────────────────────
N8N_WEBHOOK_URL=
N8N_HOST=
N8N_API_KEY=
SCANDRIX_RUNTIME_USER=
SCANDRIX_RUNTIME_PASSWORD=

# Required by docker-compose.yml (F-54). Redis backs the rate limiters and
# the account-lockout counter, so it must not be reachable unauthenticated.
REDIS_PASSWORD=

# ==============================================================================
# 30. CLOUDFLARE (DNS, CDN, WAF, TUNNEL) & AWS TERRAFORM DEPLOYMENT
# ==============================================================================
# Cloudflare Free (DNS + CDN + WAF + Tunnel, no R2 — R2 needs a card)
# dash.cloudflare.com > Domain Overview (Zone ID) + My Profile > API Tokens
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_DOMAIN=
# Zero Trust > Networks > Tunnels > Create scandrix-prod > copy token
TUNNEL_TOKEN=
TUNNEL_ID=

# AWS with $100 credits (compute only — DB/MQ/storage stay free-tier above)
# IAM user/role for Terraform + S3 backend for terraform init -backend-config=backend.hcl
AWS_REGION=
AWS_ACCOUNT_ID=
TF_VAR_jwt_secret=
TF_VAR_api_image_tag=
TF_VAR_worker_image_tag=
TF_VAR_webhooks_image_tag=
TF_VAR_alert_email=
