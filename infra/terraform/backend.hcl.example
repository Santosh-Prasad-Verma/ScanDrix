# Copy to backend.hcl, fill in for the target account, then:
#   terraform init -backend-config=backend.hcl
#
# AUDIT_REMEDIATION.md F-59. These are backend arguments, not variables, so
# they cannot live in variables.tf.
#
# The bucket and lock table must be created once per account before first use.
# Terraform cannot create the backend it stores state in.
#
#   aws s3api put-bucket-versioning --bucket <bucket> --versioning-configuration Status=Enabled
#   aws s3api put-bucket-encryption --bucket <bucket> --server-side-encryption-configuration '{"Rules":[{"ApplyServerSideEncryptionByDefault":{"SSEAlgorithm":"AES256"}}]}'
#   aws dynamodb create-table --table-name <table> --attribute-definitions AttributeName=LockID,AttributeType=S \
#     --key-schema AttributeName=LockID,KeyType=HASH --billing-mode PAY_PER_REQUEST

bucket = "REPLACE_ME-scandrix-terraform-state"
key    = "production/terraform.tfstate"
region = "ap-south-1"

# State locking. S3-native locking (use_lockfile) needs no DynamoDB table; drop
# this line and set dynamodb_table instead if you are on an older Terraform.
use_lockfile = true

# Always encrypt state: it contains secrets in sensitive variable values.
encrypt = true
