meta {
  name: 02 - Login Account
  type: http
  seq: 2
}

post {
  url: {{apiBaseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "{{userEmail}}",
    "password": "{{userPassword}}"
  }
}

script:pre-request {
  // Fallback to dynamic registration email if userEmail secret is not explicitly set
  if (!bru.getEnvVar('userEmail') && bru.getVar('dynamicUserEmail')) {
    bru.setVar('userEmail', bru.getVar('dynamicUserEmail'));
    bru.setVar('userPassword', bru.getVar('dynamicUserPassword'));
  }
}

tests {
  test("Login returns 200 OK", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("Session JWT returned and saved to authToken", function() {
    const data = res.getBody();
    const token = data.accessToken || data.token || (data.data && data.data.accessToken);
    expect(token).to.be.a('string');
    bru.setVar('authToken', token);
    const wsId = data.workspace_id || (data.user && (data.user.workspace_id || data.user.WorkspaceID || data.user.organizationId || data.user.id));
    if (wsId) {
      bru.setVar('workspaceId', wsId);
    }
  });
}
