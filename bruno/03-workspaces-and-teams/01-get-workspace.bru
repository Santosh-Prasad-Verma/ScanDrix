meta {
  name: 01 - Get Current Workspace Details
  type: http
  seq: 1
}

get {
  url: {{apiBaseUrl}}/api/v1/workspaces/current
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{authToken}}
}

tests {
  test("Status code is 200 OK or 401/404", function() {
    expect([200, 401, 404]).to.include(res.getStatus());
  });

  test("Workspace payload contains id and name", function() {
    if (res.getStatus() === 200) {
      const data = res.getBody();
      expect(data.id || data.workspace_id).to.be.ok;
    }
  });
}
