meta {
  name: 04 - Prometheus Metrics Endpoint
  type: http
  seq: 4
}

get {
  url: {{apiBaseUrl}}/metrics
  body: none
  auth: none
}

tests {
  test("Status code is 200 OK", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("Contains Prometheus metric format headers or body", function() {
    const text = res.getBody();
    expect(text).to.be.a('string');
  });
}
