# ==============================================================================
# ScanDrix Production Environment Configuration
# Location on EC2: /home/ubuntu/ScanDrix/.env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. RUNTIME & GENERAL SETTINGS
# ------------------------------------------------------------------------------
APP_ENV=production
API_NODE_ENV=production
API_CLOUD_MODE=true
API_DEVELOPMENT_MODE=false
RUN_MIGRATIONS=true
PORT=8080
API_PORT=8080
WEBHOOKS_PORT=8081

# Public URL of your ScanDrix frontend (hosted on Vercel)
APP_BASE_URL=https://scandrix.dev
API_URL=https://api.scandrix.dev
API_FRONTEND_URL=https://scandrix.dev

# ------------------------------------------------------------------------------
# 2. SUPABASE POSTGRESQL (Database & pgvector)
# Replace [YOUR-PASSWORD] and [YOUR-PROJECT-REF] with your Supabase credentials
# ------------------------------------------------------------------------------
# Transaction-mode connection pooler (IPv4 compatible, Port 6543)
DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-southeast-2.pooler.supabase.com:6543/postgres?sslmode=require

# Direct session-mode connection (Port 5432, used for migrations)
DIRECT_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-southeast-2.pooler.supabase.com:5432/postgres?sslmode=require

SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ------------------------------------------------------------------------------
# 3. MANAGED RABBITMQ (CloudAMQP)
# Paste your CloudAMQP AMQPS URI here
# ------------------------------------------------------------------------------
RABBITMQ_URL=amqps://[USER]:[PASSWORD]@[HOST]/[VHOST]
API_RABBITMQ_ENABLED=true
WORKER_CONCURRENCY=4
WORKER_HEALTH_PORT=8082

# ------------------------------------------------------------------------------
# 4. REDIS (Runs locally in Docker on EC2 for cache & rate limiting)
# ------------------------------------------------------------------------------
REDIS_PASSWORD=scandrix_secure_redis_token_change_me
REDIS_URL=redis://:scandrix_secure_redis_token_change_me@redis:6379/0

# ------------------------------------------------------------------------------
# 5. SECURITY & JWT (Must match Vercel frontend JWT_SECRET)
# ------------------------------------------------------------------------------
JWT_SECRET=super_secret_jwt_key_at_least_32_characters_long
API_JWT_SECRET=super_secret_jwt_key_at_least_32_characters_long
API_JWT_EXPIRES_IN=7d
API_JWT_REFRESH_SECRET=super_secret_refresh_jwt_key_at_least_32_chars
API_JWT_REFRESH_EXPIRES_IN=30d

# ------------------------------------------------------------------------------
# 6. LLM / AI PROVIDERS (BYO-LLM & Default Review Engines)
# ------------------------------------------------------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
