{
  "openapi": "3.1.0",
  "info": {
    "title": "ScanDrix Enterprise API",
    "description": "High-Performance AI-Powered Automated Code Review, Rule Engine, and SCM Security Platform.",
    "version": "1.0.0",
    "contact": {
      "name": "ScanDrix Engineering",
      "url": "https://scandrix.dev",
      "email": "support@scandrix.dev"
    },
    "license": {
      "name": "Proprietary Enterprise License"
    }
  },
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "Local Development Server"
    },
    {
      "url": "https://api.scandrix.dev",
      "description": "Production Cloud Gateway"
    }
  ],
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Standard JWT Bearer token obtained via /api/v1/auth/login or CLI session"
      },
      "CLIKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "x-team-key",
        "description": "ScanDrix Team CLI Key (starts with scandrix_*)"
      }
    },
    "schemas": {
      "LoginRequest": {
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "example": "admin@scandrix.dev"
          },
          "password": {
            "type": "string",
            "format": "password",
            "example": "SuperSecret123!"
          }
        }
      },
      "RegisterRequest": {
        "type": "object",
        "required": [
          "email",
          "password",
          "displayName",
          "workspaceName"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "example": "admin@scandrix.dev"
          },
          "password": {
            "type": "string",
            "format": "password",
            "example": "SuperSecret123!"
          },
          "displayName": {
            "type": "string",
            "example": "System Administrator"
          },
          "workspaceName": {
            "type": "string",
            "example": "Core Engineering"
          }
        }
      },
      "TriggerReviewRequest": {
        "type": "object",
        "required": [
          "repository",
          "pull_request_id"
        ],
        "properties": {
          "repository": {
            "type": "string",
            "example": "acme/backend"
          },
          "pull_request_id": {
            "type": "integer",
            "example": 42
          },
          "commit_sha": {
            "type": "string",
            "example": "HEAD"
          },
          "dry_run": {
            "type": "boolean",
            "default": false
          }
        }
      },
      "DryRunRuleRequest": {
        "type": "object",
        "required": [
          "rule",
          "sample_code"
        ],
        "properties": {
          "rule": {
            "type": "string",
            "example": "no-hardcoded-secrets"
          },
          "sample_code": {
            "type": "string",
            "example": "const apiKey = \"sk-12345\";"
          }
        }
      },
      "WarehouseSyncRequest": {
        "type": "object",
        "properties": {
          "destination": {
            "type": "string",
            "enum": [
              "snowflake",
              "bigquery",
              "clickhouse"
            ],
            "example": "snowflake"
          },
          "force_full_sync": {
            "type": "boolean",
            "default": false
          }
        }
      },
      "StandardResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "ok"
          },
          "message": {
            "type": "string",
            "example": "Operation completed successfully"
          }
        }
      },
      "HealthProbeResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "ok"
          },
          "version": {
            "type": "string",
            "example": "1.0.0"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "details": {
            "type": "object"
          }
        }
      }
    }
  },
